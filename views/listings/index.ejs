<% layout("/layouts/boilerplate") %>
    <!-- <h3>All Listings</h3> -->
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending </p>
        </div>
         <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Cozey</p>
        </div>
         <div class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Cities</p>
        </div>
         <div class="filter">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>BoatHouse</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-skiing"></i></div>
            <p>Skiing</p>
        </div>
        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castal</p>
        </div>
         <div class="filter">
            <div><i class="fa-solid fa-tree"></i></div>
            <p>Forest</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Igloo</p>
        </div>
        <!-- <div class="filter">
            <div><i class="fa-solid fa-shuttle-space"></i></div>
            <p>Space-Rocket</p>
        </div> -->
        <div class="filter">
            <div><i class="fa-solid fa-caravan"></i></div>
            <p>Caravan</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tent"></i></div>
            <p>Camping</p>
        </div>
        <!-- <div class="filter">
            <div><i class="fa-solid fa-champagne-glasses"></i></div>
            <p>Restro</p>
        </div> -->
        <div class="filter">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farm</p>
        </div>
        <!-- <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Pools</p>
        </div> -->
    
        <div class="tax-toggle">
            <div class="form-check form-switch">

                <label 
                    class="form-check-label" 
                    for="flexSwitchCheckDefault">
                    Display total after taxes
                </label>

                <input 
                    type="checkbox" 
                    class="form-check-input" 
                    role="switch" 
                    id="flexSwitchCheckDefault"
                />
            </div>
        </div>
        
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
     <div class="card col listing-card" >
         <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image " style="height: 20rem;">
        <div class="card-img-overlay"></div>
        <div class="card-body">
            <p class="card-text">
                <b> <%= listing.title %></b> <br>
               <!--  check if price exists first -->
                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> /night
                <i class="tax-info">&nbsp;&nbsp; +18% GST</i>
            </p>
        </div>
     </div>
    </a>
    
    <% } %>
    </div> 
    